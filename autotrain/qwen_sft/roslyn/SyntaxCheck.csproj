<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal Roslyn syntax checker. Built locally into runs/ (gitignored);
       no NuGet packages: references the DLLs shipped with dotnet SDK 8.0.204.
       If the installed SDK version changes, update RoslynDir to the matching
       <sdk>\Roslyn\bincore\ directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SyntaxCheck</AssemblyName>
    <RoslynDir>C:\Program Files\dotnet\sdk\8.0.204\Roslyn\bincore\</RoslynDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(RoslynDir)Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(RoslynDir)Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
